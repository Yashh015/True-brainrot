{
  "name": "true-brainrot",
  "productName": "True Brainrot",
  "version": "0.1.0",
  "description": "A feed panel that steps aside the moment Claude needs you",
  "author": "United Instruments",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prestart": "node make-config.js",
    "start": "electron .",
    "test": "node --test",
    "predist": "node make-config.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "net.unitedinstruments.truebrainrot",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "state.js",
      "winwatch.js",
      "links.js",
      "install-hooks.js",
      "cookies.js",
      "access.js",
      "account.js",
      "config.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false,
      "loadBrowserProcessSpecificV8Snapshot": false
    }
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.17.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "koffi": "3.3.3"
  }
}
